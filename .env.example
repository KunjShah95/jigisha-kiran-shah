# Environment Configuration
# Copy this file to .env.local and update values as needed

# App Configuration
VITE_APP_NAME=jigisha-kiran-shah

# API Configuration (if needed)
# VITE_API_URL=https://api.example.com

# Google Analytics 4 measurement ID (optional). Set in Vercel → Project →
# Environment Variables (Production). Loads only on www.jigishakiranshah.in.
# VITE_GA4_ID=G-XXXXXXXXXX

# Microsoft Clarity project ID (optional) — heatmaps and session recordings.
# Production host only. Keep Masking on "Strict" in the Clarity dashboard so
# form input is never recorded. /privacy lists Clarity automatically when set.
# VITE_CLARITY_ID=xxxxxxxxxx

# Cloudinary (optional) - enables CDN delivery + upload widget in the Gallery page.
# Create an unsigned upload preset in the Cloudinary dashboard for uploads to work.
VITE_CLOUDINARY_CLOUD_NAME=root
VITE_CLOUDINARY_UPLOAD_PRESET=jigisha_gallery_undefined

# Note: there are no lead-capture variables. Forms open WhatsApp directly and
# nothing is stored on a server. See docs/LEAD-CAPTURE.md.
